    "components": {
        "schemas": {
            "ArchivoSalida": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "Id"
                    },
                    "nombre_original": {
                        "type": "string",
                        "title": "Nombre Original"
                    },
                    "formato": {
                        "type": "string",
                        "title": "Formato"
                    },
                    "cantidad_registros": {
                        "type": "integer",
                        "title": "Cantidad Registros"
                    },
                    "columnas": {
                        "items": {
                            "additionalProperties": true,
                            "type": "object"
                        },
                        "type": "array",
                        "title": "Columnas"
                    },
                    "vista_previa": {
                        "$ref": "#/components/schemas/VistaPrevia"
                    }
                },
                "type": "object",
                "required": [
                    "id",
                    "nombre_original",
                    "formato",
                    "cantidad_registros",
                    "columnas",
                    "vista_previa"
                ],
                "title": "ArchivoSalida"
            },
            "Body_cargar_archivos_post": {
                "properties": {
                    "archivo": {
                        "type": "string",
                        "format": "binary",
                        "title": "Archivo"
                    }
                },
                "type": "object",
                "required": [
                    "archivo"
                ],
                "title": "Body_cargar_archivos_post"
            },
            "ConfirmarEntrada": {
                "properties": {
                    "nombre_tabla": {
                        "type": "string",
                        "maxLength": 100,
                        "minLength": 3,
                        "pattern": "^[A-Za-z0-9_\\-]+$",
                        "title": "Nombre Tabla",
                        "examples": [
                            "ventas_sep_2026_limpia"
                        ]
                    },
                    "columna_fecha": {
                        "type": "string",
                        "title": "Columna Fecha"
                    },
                    "columna_valor": {
                        "type": "string",
                        "title": "Columna Valor"
                    }
                },
                "type": "object",
                "required": [
                    "nombre_tabla",
                    "columna_fecha",
                    "columna_valor"
                ],
                "title": "ConfirmarEntrada"
            },
            "HTTPValidationError": {
                "properties": {
                    "detail": {
                        "items": {
                            "$ref": "#/components/schemas/ValidationError"
                        },
                        "type": "array",
                        "title": "Detail"
                    }
                },
                "type": "object",
                "title": "HTTPValidationError"
            },
            "LoginEntrada": {
                "properties": {
                    "correo": {
                        "type": "string",
                        "format": "email",
                        "title": "Correo"
                    },
                    "clave": {
                        "type": "string",
                        "maxLength": 72,
                        "minLength": 1,
                        "title": "Clave"
                    }
                },
                "type": "object",
                "required": [
                    "correo",
                    "clave"
                ],
                "title": "LoginEntrada"
            },
            "PasoEntrada": {
                "properties": {
                    "tipo": {
                        "type": "string",
                        "enum": [
                            "eliminar_columna",
                            "renombrar_columna",
                            "cambiar_tipo",
                            "formato_fecha",
                            "quitar_duplicados",
                            "quitar_caracteres"
                        ],
                        "title": "Tipo"
                    },
                    "columna": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Columna"
                    },
                    "parametros": {
                        "additionalProperties": true,
                        "type": "object",
                        "title": "Parametros",
                        "examples": [
                            {
                                "nuevo": "valor_venta"
                            }
                        ]
                    }
                },
                "type": "object",
                "required": [
                    "tipo"
                ],
                "title": "PasoEntrada"
            },
            "RegistroEntrada": {
                "properties": {
                    "nombre": {
                        "type": "string",
                        "maxLength": 100,
                        "minLength": 3,
                        "title": "Nombre",
                        "examples": [
                            "Laura G\u00f3mez"
                        ]
                    },
                    "correo": {
                        "type": "string",
                        "format": "email",
                        "title": "Correo",
                        "examples": [
                            "laura@comercialandina.co"
                        ]
                    },
                    "clave": {
                        "type": "string",
                        "maxLength": 72,
                        "minLength": 8,
                        "title": "Clave",
                        "examples": [
                            "Ventas2026"
                        ]
                    },
                    "perfil": {
                        "type": "string",
                        "enum": [
                            "analista",
                            "jefe_comercial"
                        ],
                        "title": "Perfil",
                        "default": "analista"
                    }
                },
                "type": "object",
                "required": [
                    "nombre",
                    "correo",
                    "clave"
                ],
                "title": "RegistroEntrada"
            },
            "ReporteEntrada": {
                "properties": {
                    "tabla_id": {
                        "type": "integer",
                        "title": "Tabla Id"
                    },
                    "tipo": {
                        "type": "string",
                        "enum": [
                            "tabla_dinamica",
                            "barras",
                            "lineas",
                            "torta"
                        ],
                        "title": "Tipo",
                        "default": "lineas"
                    },
                    "fecha_inicio": {
                        "anyOf": [
                            {
                                "type": "string",
                                "format": "date"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Fecha Inicio"
                    },
                    "fecha_fin": {
                        "anyOf": [
                            {
                                "type": "string",
                                "format": "date"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Fecha Fin"
                    },
                    "agrupacion": {
                        "type": "string",
                        "enum": [
                            "dia",
                            "mes",
                            "anio"
                        ],
                        "title": "Agrupacion",
                        "default": "mes"
                    }
                },
                "type": "object",
                "required": [
                    "tabla_id"
                ],
                "title": "ReporteEntrada"
            },
            "ReporteSalida": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "Id"
                    },
                    "tipo": {
                        "type": "string",
                        "title": "Tipo"
                    },
                    "agrupacion": {
                        "type": "string",
                        "title": "Agrupacion"
                    },
                    "serie": {
                        "items": {
                            "additionalProperties": true,
                            "type": "object"
                        },
                        "type": "array",
                        "title": "Serie"
                    },
                    "indicadores": {
                        "additionalProperties": true,
                        "type": "object",
                        "title": "Indicadores"
                    }
                },
                "type": "object",
                "required": [
                    "id",
                    "tipo",
                    "agrupacion",
                    "serie",
                    "indicadores"
                ],
                "title": "ReporteSalida"
            },
            "SesionSalida": {
                "properties": {
                    "id": {
                        "type": "integer",
                        "title": "Id"
                    },
                    "archivo_id": {
                        "type": "integer",
                        "title": "Archivo Id"
                    },
                    "estado": {
                        "type": "string",
