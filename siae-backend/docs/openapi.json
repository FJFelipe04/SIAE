  "components": {
    "schemas": {
      "ArchivoSalida": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "nombre_original": {
            "type": "string",
            "title": "Nombre Original"
          },
          "formato": {
            "type": "string",
            "title": "Formato"
          },
          "cantidad_registros": {
            "type": "integer",
            "title": "Cantidad Registros"
          },
          "columnas": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Columnas"
          },
          "vista_previa": {
            "$ref": "#/components/schemas/VistaPrevia"
          }
        },
        "type": "object",
        "required": [
          "id",
          "nombre_original",
          "formato",
          "cantidad_registros",
          "columnas",
          "vista_previa"
        ],
        "title": "ArchivoSalida"
      },
      "Body_cargar_archivos_post": {
        "properties": {
          "archivo": {
            "type": "string",
            "format": "binary",
            "title": "Archivo"
          }
        },
        "type": "object",
        "required": [
          "archivo"
        ],
        "title": "Body_cargar_archivos_post"
      },
      "ConfirmarEntrada": {
        "properties": {
          "nombre_tabla": {
            "type": "string",
            "maxLength": 100,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9_\\-]+$",
            "title": "Nombre Tabla",
            "examples": [
              "ventas_sep_2026_limpia"
            ]
          },
          "columna_fecha": {
            "type": "string",
            "title": "Columna Fecha"
          },
          "columna_valor": {
            "type": "string",
            "title": "Columna Valor"
          }
        },
        "type": "object",
        "required": [
          "nombre_tabla",
          "columna_fecha",
          "columna_valor"
        ],
        "title": "ConfirmarEntrada"
      },
      "EventoAuditoriaSalida": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "fecha": {
            "type": "string",
            "format": "date-time",
            "title": "Fecha"
          },
          "accion": {
            "type": "string",
            "title": "Accion"
          },
          "correo": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Correo"
          },
          "detalle": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detalle"
          },
          "ip": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ip"
          }
        },
        "type": "object",
        "required": [
          "id",
          "fecha",
          "accion"
        ],
        "title": "EventoAuditoriaSalida"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginEntrada": {
        "properties": {
          "correo": {
            "type": "string",
            "format": "email",
            "title": "Correo"
          },
          "clave": {
            "type": "string",
