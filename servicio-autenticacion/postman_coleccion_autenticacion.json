          }
        ],
        "url": {
          "raw": "{{base}}/registro",
          "host": [
            "{{base}}"
          ],
          "path": [
            "registro"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuario\": \"juanfe\",\n  \"contrasena\": \"Clave2026\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código 201', function () { pm.response.to.have.status(201); });"
            ]
          }
